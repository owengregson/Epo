{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "tests/**/*.ts", "tests/**/*.tsx"]
  },
  "formatter": { "enabled": false },
  "javascript": { "jsxRuntime": "transparent" },
  "css": {
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
    "linter": { "enabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useAriaPropsSupportedByRole": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useButtonType": "off"
      },
      "suspicious": {
        "noFocusedTests": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:sqlite": "Only src/store/driver/* may import node:sqlite (the DB stays behind the knowledge store)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    },
    {
      "includes": ["src/store/driver/**/*.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/engine/**", "@/main/**"],
                    "message": "The renderer talks to main ONLY through the window.epo bridge (src/ipc/contract.ts). Pure code both sides need lives in src/shared/*; engine and main modules must never enter the browser bundle."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/engine/**/*.ts", "src/rim/**/*.ts", "src/governors/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "setTimeout": "IG-facing cadences must not originate from raw timers here — wait through src/timing (primitives.sleep / DelayManager), which the noise layer gates.",
                  "setInterval": "IG-facing cadences must not originate from raw timers here — schedule through src/timing (ScheduleManager), which persists and jitters cadences."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.tsx", "tests/**/*.tsx"],
      "linter": { "rules": { "style": { "useImportType": "off" } } }
    },
    {
      "includes": ["tests/**/*.ts", "tests/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "noRestrictedImports": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
